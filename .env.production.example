# Production Environment Configuration
# Copy this file to .env.production or inject these variables into your deployment environment.
# Never commit real credentials or production secrets to Git.

# Node Environment
NODE_ENV=production

# MongoDB Credentials (Alphanumeric username and base64url password)
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# JWT Authentication Secret (Generate at least 32 random bytes, e.g. crypto.randomBytes(48).toString('base64url'))
AUTH_JWT_SECRET=

# Public Client Origin (Exact HTTPS URL, comma-separated if multiple, e.g. https://queue.example.com)
CLIENT_ORIGIN=https://queue.example.com

# Private Shared Storage Directory (Must be shared between API and Worker)
JOB_STORAGE_DIR=/app/storage

# Tenant Storage & Job Quotas
USER_STORAGE_QUOTA_BYTES=52428800 # 50 MB per tenant
USER_MAX_UPLOAD_COUNT=50          # Max active image uploads per tenant
USER_MAX_PENDING_JOBS=50          # Max pending jobs per tenant

# Worker Lease & Heartbeat Settings (Heartbeat must be shorter than lease)
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_DURATION_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=10000
BASE_DELAY_MS=2000
MAX_RETRY_DELAY_MS=60000
RETRY_JITTER_RATIO=0.2

# Email Provider Settings (Resend - Optional)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_SENDING_ENABLED=false
EMAIL_ALLOWED_RECIPIENTS=
EMAIL_DAILY_QUOTA_PER_USER=5
EMAIL_DAILY_QUOTA_GLOBAL=100
EMAIL_JOBS_PER_MINUTE=3
