PORT=5000
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@<cluster-host>/reliable-job-queue?retryWrites=true&w=majority&appName=reliable-job-queue"
# For Docker Compose, copy this file to the project root as .env and set these
# values locally. Keep credentials and secrets out of tracked files.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
# Generate at least 32 random bytes. The API rejects missing or short secrets.
AUTH_JWT_SECRET=
WORKER_POLL_INTERVAL_MS=2000
BASE_DELAY_MS=2000
MAX_RETRY_DELAY_MS=60000
RETRY_JITTER_RATIO=0.2
WORKER_LEASE_DURATION_MS=30000
WORKER_HEARTBEAT_INTERVAL_MS=10000
# Comma-separated dashboard origins allowed to connect to Socket.IO.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional. If omitted, each worker generates a unique ID.
# WORKER_ID=worker-local-1
# Resend email integration. Sending is disabled unless explicitly enabled.
# Shared-provider sending also requires a non-empty recipient allowlist.
# Set values only in server/.env; never expose these in client configuration.
# RESEND_API_KEY=<resend-api-key>
# EMAIL_FROM=QueueOps <queue@example.com>
# EMAIL_SENDING_ENABLED=false
# Exact recipient addresses and/or exact recipient domains, comma-separated.
# A domain entry starts with @, for example @example.com.
# EMAIL_ALLOWED_RECIPIENTS=learner@example.com,@your-verified-domain.com
# UTC daily limits apply separately to submissions/replays and actual sends.
EMAIL_DAILY_QUOTA_PER_USER=5
EMAIL_DAILY_QUOTA_GLOBAL=100
# Per-account submission/replay and actual-send attempt limits per minute.
EMAIL_JOBS_PER_MINUTE=3
EMAIL_PROVIDER_TIMEOUT_MS=10000
# Generated PDFs and processed images are stored outside MongoDB.
# JOB_STORAGE_DIR=
